# -----------------------------------------------------------------------------
# Bark
# -----------------------------------------------------------------------------

BARK_DEVICE_KEY=replace-with-your-bark-device-key # Credential; keep outside config.toml.

# -----------------------------------------------------------------------------
# ntfy
# -----------------------------------------------------------------------------

NTFY_URL=https://ntfy.sh/ # Not a credential; may be written directly in config.toml.
NTFY_TOKEN=replace-with-your-ntfy-token # Credential; keep outside config.toml.
NTFY_TOPIC=replace-with-your-ntfy-topic # A private topic can act like a shared secret; prefer env.

# -----------------------------------------------------------------------------
# Gotify
# -----------------------------------------------------------------------------

GOTIFY_URL=https://push.example.com/message # May be inline unless its hostname is private.
GOTIFY_APP_TOKEN=replace-with-your-gotify-application-token # Credential; keep outside config.toml.

# -----------------------------------------------------------------------------
# Pushover
# -----------------------------------------------------------------------------

PUSHOVER_APP_TOKEN=replace-with-your-pushover-application-token # Credential; keep outside config.toml.
PUSHOVER_USER_KEY=replace-with-your-pushover-user-or-group-key # Credential; keep outside config.toml.

# -----------------------------------------------------------------------------
# NapCat
# -----------------------------------------------------------------------------

NAPCAT_BASE_URL=ws://127.0.0.1:3001 # Not a credential; may be written directly in config.toml.
NAPCAT_ACCESS_TOKEN=replace-with-your-napcat-access-token # Credential; keep outside config.toml.
NAPCAT_GROUP_ID=123456789 # Destination ID, not a credential; may be literal in config.toml.
NAPCAT_USER_ID=987654321 # Destination ID, not a credential; may be literal in config.toml.
