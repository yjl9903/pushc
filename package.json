{
  "name": "@pushc/monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "format": "prettier --write '**/*.{ts,js,mjs}'",
    "pushc": "tsx apps/pushc/src/cli.ts",
    "release": "bumpp package.json apps/*/package.json packages/*/package.json skills/*/SKILL.md --commit --push --tag",
    "test:ci": "turbo run test:ci",
    "typecheck": "turbo run typecheck",
    "preversion": "turbo run test:ci"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "bumpp": "latest",
    "prettier": "^3.9.6",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.1",
    "turbo": "^2.10.5",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=v24.0.0"
  }
}
